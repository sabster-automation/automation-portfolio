{
  "name": "automation-portfolio",
  "version": "1.0.0",
  "description": "Portfolio showcase for Test Automation Engineer - Playwright + TypeScript with Visual Regression & Multi-Environment support",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:staging": "cross-env ENV=staging playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:visual": "playwright test --grep @visual --update-snapshots",
    "test:visual:ci": "playwright test --grep @visual",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:allure": "playwright test --reporter=line,allure-playwright",
    "codegen": "playwright codegen",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}
